@acciovac.API_HostAddress = http://localhost:5265
@userId = 129f1842-02b1-4f12-8a96-695603b2f311

GET {{acciovac.API_HostAddress}}/health
Accept: application/json

###

# Create User
POST {{acciovac.API_HostAddress}}/api/users/create
Content-Type: application/json

{
  "firebaseUid": "test-firebase-uid-123",
  "email": "test@example.com",
  "displayName": "Test User",
  "photoUrl": null,
  "phoneNumber": null,
  "createdBy": "system"
}

###

# Get Active Rate
GET {{acciovac.API_HostAddress}}/api/rates
Accept: application/json

###

# Create Tuk Tuk Rate
POST {{acciovac.API_HostAddress}}/api/rates
Content-Type: application/json

{
  "baseFare": 50.00,
  "perKm": 30.00,
  "nightMultiplier": 1.5,
  "peakMultiplier": 1.3
}

###

# Update Tuk Tuk Rate
# First run GET to get the rate ID, then replace {rate-id} below
PUT {{acciovac.API_HostAddress}}/api/rates/09fc6d1c-47db-4001-aab7-d82e4ef3aafc
Content-Type: application/json

{
  "baseFare": 60.00,
  "perKm": 35.00,
  "nightMultiplier": 1.8,
  "peakMultiplier": 1.5
}

###

# Get All Local Experiences
GET {{acciovac.API_HostAddress}}/api/localexpirences
Accept: application/json

###

# Add Local Experience
POST {{acciovac.API_HostAddress}}/api/localexpirences
Content-Type: application/json

{
  "locationName": "Traditional Cookery Class",
  "description": "Learn to cook authentic Sri Lankan dishes with a local family."
}

###

# Upload Local Experience Photo
# Replace {id} with the local experience GUID from the GET response
POST {{acciovac.API_HostAddress}}/api/localexpirences/06d16819-8912-485b-a395-1a97a2deae33/photos
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="photo.jpg"
Content-Type: image/jpeg

< ./photo.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

###

# Update Local Experience
# Replace {id} with the actual GUID from the GET response
PUT {{acciovac.API_HostAddress}}/api/localexpirences/{id}
Content-Type: application/json

{
  "locationName": "Traditional Cookery Class",
  "description": "Updated description for the cookery class experience."
}

###

# Delete Local Experience
# Replace {id} with the actual GUID from the GET response
DELETE {{acciovac.API_HostAddress}}/api/localexpirences/{id}

###

# ───────────── MESSAGES ─────────────

# Get All Messages
GET {{acciovac.API_HostAddress}}/api/messages
Accept: application/json

###

# Create Message
POST {{acciovac.API_HostAddress}}/api/messages
Content-Type: application/json

{
  "userId": "129f1842-02b1-4f12-8a96-695603b2f311",
  "subject": "Need help with booking",
  "body": "I could not complete my booking flow. Please check.",
  "createdBy": "system"
}

###

# Get User Messages
# Replace @userId at the top with a real GUID
GET {{acciovac.API_HostAddress}}/api/messages/user/{{userId}}
Accept: application/json

###

# Mark Message as Read
# First run GET to get the message ID, then replace {message-id} below
PUT {{acciovac.API_HostAddress}}/api/messages/{message-id}/read

###

# Mark Message as Resolved
# First run GET to get the message ID, then replace {message-id} below
PUT {{acciovac.API_HostAddress}}/api/messages/{message-id}/resolve

###

# Delete Message
# Replace {message-id} with the actual GUID from the GET response
DELETE {{acciovac.API_HostAddress}}/api/messages/{message-id}

